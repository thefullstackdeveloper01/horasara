# Razorpay payment gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-long-random-webhook-secret
RAZORPAY_CURRENCY=INR

# Daily report email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=HoraSaar <reports@example.com>

# Runtime paths
HORASAAR_SUBSCRIPTIONS_FILE=data/runtime/subscriptions.json
HORASAAR_OUTBOX_DIR=data/runtime/outbox
SCHEDULER_POLL_MS=60000

# Private administrator control room. No public user login/registration.
ADMIN_ROUTE=/_jv-control-7f3c9a1d
ADMIN_USERNAME=replace-with-a-private-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# --- Company / legal identity ------------------------------------------------
# Used by the administrative pages (Privacy Policy, Terms, Contact, About,
# Refund Policy, Press, etc.). Until these are set to real values, those pages
# render an honest "not configured yet" notice instead of publishing invented
# company details — do not launch to production with the placeholders below.
BRAND_NAME=HoraSaar
BRAND_TAGLINE=Personal Jyotish guidance, explained as timing
COMPANY_LEGAL_NAME=replace-with-your-registered-business-name
COMPANY_FOUNDED_YEAR=2024
COMPANY_COUNTRY=India
# Pipe-separated address lines, e.g. "123 MG Road|Ahmedabad|Gujarat 380001|India"
COMPANY_ADDRESS=replace-with-your-registered-postal-address
COMPANY_GSTIN=
COMPANY_CIN=
LEGAL_JURISDICTION=the courts of Ahmedabad, Gujarat, India
GOVERNING_LAW=the laws of India
POLICY_EFFECTIVE_DATE=2026-01-15

# Contact addresses shown across the legal, company and support pages.
# All default to SUPPORT_EMAIL when left blank, so setting SUPPORT_EMAIL alone
# is enough to get started; set the others for routing to different inboxes.
SUPPORT_EMAIL=replace-with-your-support-address
PRIVACY_EMAIL=
GRIEVANCE_EMAIL=
LEGAL_EMAIL=
PRESS_EMAIL=
CAREERS_EMAIL=
SECURITY_EMAIL=
AFFILIATE_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=Monday to Saturday, 10:00–18:00 IST
SUPPORT_RESPONSE_TARGET=two working days
GRIEVANCE_OFFICER_NAME=
DPO_NAME=

# Comma-separated role ids from src/content/Openings.js currently hiring.
# Leave blank to show every role as "accepting expressions of interest".
HORASAAR_OPEN_ROLES=

# Contact form and reader-feedback submissions.
HORASAAR_MESSAGES_FILE=data/runtime/messages.json
RATE_LIMIT_CONTACT=5
RATE_LIMIT_SEARCH=40

# Set to true to serve the maintenance page for all public traffic while
# keeping /health, the admin route and the Razorpay webhook reachable.
MAINTENANCE_MODE=false

# Production server
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://your-domain.example

# Operational limits
RATE_LIMIT_PREDICTION=30
RATE_LIMIT_CHECKOUT=10
RATE_LIMIT_PAYMENT_VERIFY=20
RATE_LIMIT_CALCULATOR=30
RATE_LIMIT_MILAN=10
MAX_BODY_BYTES=1048576

# Confirmation email after verified payment
SUBSCRIPTION_CONFIRMATION_EMAIL=true

# Optional trusted proxy: only set when your reverse proxy is configured correctly
TRUST_PROXY=false

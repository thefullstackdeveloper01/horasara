    "data": {
      "name": "D10 Dashamsa Career Rules",
      "description": "D10 detailed interpretation rules for career, profession, status, and authority",
      "source": "Parashara Hora Shastra & classical texts",
      "overview": "The 10th harmonic (D10) = divisions of 30° into 10 parts of 3°. Shows career destiny, professional life, authority, public image, father.",
      "rules": {
        "_items": [
          {
            "rule_id": 1,
            "name": "Lagna in D10",
            "interpretation": "Lagna lord in D10 = professional identity, career aptitude",
            "strong": "Exalted/own house = successful, authoritative professional",
            "weak": "Debilitated = career struggles, lack of authority"
          },
          {
            "rule_id": 2,
            "name": "10th House in D10",
            "interpretation": "Shows actual profession, job satisfaction, reputation",
            "planets_in_10th": "Each planet describes career type",
            "sun_10th": "Government, leadership, administration",
            "moon_10th": "Public service, nursing, hospitality",
            "mercury_10th": "Commerce, media, communication",
            "venus_10th": "Arts, beauty, finance, luxury",
            "mars_10th": "Military, police, engineering, machinery",
            "jupiter_10th": "Education, law, clergy, guru",
            "saturn_10th": "Mines, labor, agriculture, old industry"
          },
          {
            "rule_id": 3,
            "name": "Amatya Karaka (AK)",
            "interpretation": "Strongest planet = profession indicator",
            "ak_sign": "AK's sign in D10 = career field",
            "ak_placement": "AK in 10th = powerful career; AK in 6/8/12 = challenges"
          },
          {
            "rule_id": 4,
            "name": "10th Lord in D10",
            "interpretation": "Career prospects, professional achievement",
            "strong_10l": "Exalted/own house = high position, respect, wealth",
            "weak_10l": "Retrograde/debilitated/malefic = career blocks, failures"
          },
          {
            "rule_id": 5,
            "name": "Saturn in D10",
            "interpretation": "Hard work, perseverance, responsibility in career",
            "strong": "Saturn in 10th D10 = slow but steady rise, mastery through discipline",
            "weak": "Saturn in 6/8/12 = job loss, penalties, public humiliation"
          },
          {
            "rule_id": 6,
            "name": "Business vs Employment",

              "outcomeJD"
            ]
          },
          {
            "_text": [
              "outcome"
            ]
          }
        ]
      },
      "outcome": "binary: 1/0 or yes/no",
      "optional": {
        "_items": [
          {
            "_text": [
              "eventType"
            ]
          },
          {
            "_text": [
              "prediction"
            ]
          },
          {
            "_text": [
              "birthDataHash"
            ]
          },
          {
            "_text": [
              "chartConfigHash"
            ]
          },
          {
            "_text": [
              "source"
            ]
          },
          {
            "_text": [
              "notes"
            ]
          }
        ]
      },
      "rules": {
        "_items": [
          {
            "_text": [
              "predictionCutoffJD must be strictly before outcomeJD"
            ]
          },
          {
            "_text": [
              "one row represents one prediction made at one historical cutoff"
            ]
          },
          {
            "_text": [
              "outcomes must be independently observed and not generated by the predictor"
            ]
          },
          {
            "_text": [
              "synthetic test data must never be labelled as empirical evidence"
            ]
          }
        ]
      }
    }

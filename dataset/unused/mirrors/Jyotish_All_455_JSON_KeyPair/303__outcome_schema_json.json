    "data": {
      "version": "1.0.0",
      "status": "SCHEMA_ONLY",
      "purpose": "Historical prediction outcome records for leakage-resistant backtesting and empirical calibration.",
      "required": {
        "_items": [
          {
            "_text": [
              "id"
            ]
          },
          {
            "_text": [
              "predictionCutoffJD"

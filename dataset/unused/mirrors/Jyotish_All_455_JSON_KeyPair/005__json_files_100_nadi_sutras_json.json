    "records": [
      {
        "id": 1,
        "sanskrit": "Karmany evadhikaras te ma phaleshu kadachana",
        "english": "You have the right to action alone, never to its fruits.",
        "theme": "Karma Yoga",
        "source": "Bhagavad Gita 2.47"
      },
      {
        "id": 2,
        "sanskrit": "Yoga-sthah kuru karmani sangam tyaktva dhananjaya",
        "english": "Established in yoga, perform actions, abandoning attachment, O Arjuna.",
        "theme": "Karma Yoga",
        "source": "Bhagavad Gita 2.48"
      },
      {
        "id": 3,
        "sanskrit": "Sukha-duhkhe same kritva labhalabhau jayajayau",
        "english": "Treating pleasure and pain, gain and loss, victory and defeat equally.",
        "theme": "Equanimity",
        "source": "Bhagavad Gita 2.38"
      },
      {
        "id": 4,
        "sanskrit": "Atmaiva hy atmano bandhur atmaiva ripur atmanah",
        "english": "The self is the friend of the self, and the self is the enemy of the self.",
        "theme": "Self-Discipline",
        "source": "Bhagavad Gita 6.5"
      },
      {
        "id": 5,
        "sanskrit": "Uddhared atmanatmanam natmanam avasadayet",
        "english": "One should uplift oneself by oneself; one should not degrade oneself.",
        "theme": "Self-Improvement",
        "source": "Bhagavad Gita 6.5"
      },
      {
        "id": 6,
        "sanskrit": "Yatra yogeshvarah krishno yatra partho dhanur-dharah",
        "english": "Wherever there is Krishna, the master of yoga, and Arjuna, the wielder of the bow, there will surely be victory, prosperity, and righteousness.",
        "theme": "Divine Guidance",
        "source": "Bhagavad Gita 18.78"
      },
      {
        "id": 7,
        "sanskrit": "Paritranaya sadhunam vinashaya cha dushkritam",
        "english": "For the protection of the good and the destruction of the wicked.",
        "theme": "Divine Purpose",
        "source": "Bhagavad Gita 4.8"
      },
      {
        "id": 8,
        "sanskrit": "Dharma-samsthapanarthaya sambhavami yuge yuge",
        "english": "I manifest age after age to reestablish dharma.",
        "theme": "Dharma",
        "source": "Bhagavad Gita 4.8"
      },
      {
        "id": 9,
        "sanskrit": "Yada yada hi dharmasya glanir bhavati bharata",
        "english": "Whenever there is a decline of dharma, O Bharata.",
        "theme": "Dharma",
        "source": "Bhagavad Gita 4.7"
      },
      {
        "id": 10,
        "sanskrit": "Abhyasa-vairagyabhyam tan-nirodhah",
        "english": "The mind is restrained by practice and detachment.",
        "theme": "Mind Control",
        "source": "Yoga Sutras 1.12"
      },
      {
        "id": 11,
        "sanskrit": "Yogash chitta-vritti-nirodhah",
        "english": "Yoga is the cessation of the modifications of the mind.",
        "theme": "Yoga",
        "source": "Yoga Sutras 1.2"
      },
      {
        "id": 12,
        "sanskrit": "Tada drashtuh svarupe avasthanam",
        "english": "Then the seer abides in its own true nature.",
        "theme": "Self-Realization",
        "source": "Yoga Sutras 1.3"
      },
      {
        "id": 13,
        "sanskrit": "Vritti-sarupyam itaratra",
        "english": "At other times, the seer identifies with the modifications of the mind.",
        "theme": "Ignorance",
        "source": "Yoga Sutras 1.4"
      },
      {
        "id": 14,
        "sanskrit": "Pramana-viparyaya-vikalpa-nidra-smritayah",
        "english": "The modifications are right knowledge, wrong knowledge, imagination, sleep, and memory.",
        "theme": "Mind",
        "source": "Yoga Sutras 1.6"
      },
      {
        "id": 15,
        "sanskrit": "Drashta drishimatrah shuddho 'pi pratyaya-anupashyah",
        "english": "The seer is pure consciousness, but appears to be colored by the mind.",
        "theme": "Consciousness",
        "source": "Yoga Sutras 2.20"
      },
      {
        "id": 16,
        "sanskrit": "Heyam duhkham anagatam",
        "english": "Future suffering can be avoided.",
        "theme": "Suffering",
        "source": "Yoga Sutras 2.16"
      },
      {
        "id": 17,
        "sanskrit": "Drashta-drishyayoh samyogo heya-hetuh",
        "english": "The cause of suffering is the union of the seer and the seen.",
        "theme": "Suffering",
        "source": "Yoga Sutras 2.17"
      },
      {
        "id": 18,
        "sanskrit": "Avidya-Asmita-Raga-Dvesha-Abhiniveshah kleshah",
        "english": "The afflictions are ignorance, egoism, attachment, aversion, and fear of death.",
        "theme": "Afflictions",
        "source": "Yoga Sutras 2.3"
      },
      {
        "id": 19,
        "sanskrit": "Anityashuchi-duhkhanatmasu nitya-shuchi-sukhatma-khyatir avidya",
        "english": "Ignorance is mistaking the impermanent, impure, painful, and non-self for the permanent, pure, pleasurable, and self.",
        "theme": "Ignorance",
        "source": "Yoga Sutras 2.5"
      },
      {
        "id": 20,
        "sanskrit": "Sattva-purushayoh atyanta-asankhyatoh",
        "english": "The purity of the mind and the seer are absolutely distinct.",
        "theme": "Discernment",
        "source": "Yoga Sutras 2.19"
      },
      {
        "id": 21,
        "sanskrit": "Tasya heyah hetuh avidya",
        "english": "The cause of suffering is ignorance.",
        "theme": "Ignorance",
        "source": "Yoga Sutras 2.24"
      },
      {
        "id": 22,
        "sanskrit": "Hanam duhkham anagatam",
        "english": "The avoidance of future suffering is the goal.",
        "theme": "Liberation",
        "source": "Yoga Sutras 2.16"
      },
      {
        "id": 23,
        "sanskrit": "Samyag-darshana-vishuddhih",
        "english": "Purity of right vision.",
        "theme": "Wisdom",
        "source": "Yoga Sutras 2.25"
      },
      {
        "id": 24,
        "sanskrit": "Viveka-khyatir aviplava",
        "english": "Uninterrupted discriminative awareness.",
        "theme": "Discernment",
        "source": "Yoga Sutras 2.26"
      },
      {
        "id": 25,
        "sanskrit": "Tasya saptadha pranta-bhumih prajnaya",
        "english": "The yogi's insight becomes sevenfold and reaches the highest ground.",
        "theme": "Enlightenment",
        "source": "Yoga Sutras 2.27"
      },
      {
        "id": 26,
        "sanskrit": "Yoganganushthanad ashuddhi-kshaye jnana-diptir a-viveka-khyateh",
        "english": "By practicing the limbs of yoga, impurities are destroyed and the light of knowledge shines.",
        "theme": "Yoga Practice",
        "source": "Yoga Sutras 2.28"
      },
      {
        "id": 27,
        "sanskrit": "Yama-niyama-asana-pranayama-pratyahara-dharana-dhyana-samadhayah ashtau angani",
        "english": "The eight limbs are yama, niyama, asana, pranayama, pratyahara, dharana, dhyana, and samadhi.",
        "theme": "Ashtanga Yoga",
        "source": "Yoga Sutras 2.29"
      },
      {
        "id": 28,
        "sanskrit": "Ahimsa-satya-asteya-brahmacharya-aparigrahah yamah",
        "english": "Non-violence, truthfulness, non-stealing, celibacy, and non-possessiveness are the yamas.",
        "theme": "Ethics",
        "source": "Yoga Sutras 2.30"
      },
      {
        "id": 29,
        "sanskrit": "Shaucha-santosha-tapah-svadhyaya-Ishvara-pranidhanani niyamah",
        "english": "Purity, contentment, austerity, self-study, and surrender to God are the niyamas.",
        "theme": "Ethics",
        "source": "Yoga Sutras 2.32"
      },
      {
        "id": 30,
        "sanskrit": "Sthira-sukham asanam",
        "english": "Asana is a steady, comfortable posture.",
        "theme": "Asana",
        "source": "Yoga Sutras 2.46"
      },
      {
        "id": 31,
        "sanskrit": "Prayatna-shaithilya-ananta-samapattibhyam",
        "english": "By loosening effort and meditating on the infinite.",
        "theme": "Asana",
        "source": "Yoga Sutras 2.47"
      },
      {
        "id": 32,
        "sanskrit": "Tatah dvandva-anabhighatah",
        "english": "Then one is not disturbed by dualities.",
        "theme": "Equanimity",
        "source": "Yoga Sutras 2.48"
      },
      {
        "id": 33,
        "sanskrit": "Tasmin sati shvasa-prashvasayoh gati-vichchhedah pranayamah",
        "english": "Pranayama is the regulation of inhalation and exhalation.",
        "theme": "Pranayama",
        "source": "Yoga Sutras 2.49"
      },
      {
        "id": 34,
        "sanskrit": "Svavishaya-asamprayoge chitta-svarupa-anukarah iva indriyanam pratyaharah",
        "english": "Pratyahara is the withdrawal of the senses from their objects.",
        "theme": "Pratyahara",
        "source": "Yoga Sutras 2.54"
      },
      {
        "id": 35,
        "sanskrit": "Desha-bandhah chittasya dharana",
        "english": "Dharana is the binding of the mind to one place.",
        "theme": "Dharana",
        "source": "Yoga Sutras 3.1"
      },
      {
        "id": 36,
        "sanskrit": "Tatra pratyaya-ekatanata dhyanam",
        "english": "Dhyana is the continuous flow of one thought.",
        "theme": "Dhyana",
        "source": "Yoga Sutras 3.2"
      },
      {
        "id": 37,
        "sanskrit": "Tad eva artha-matra-nirbhasam svarupa-shunyam iva samadhih",
        "english": "Samadhi is when the mind shines as the object alone, empty of itself.",
        "theme": "Samadhi",
        "source": "Yoga Sutras 3.3"
      },
      {

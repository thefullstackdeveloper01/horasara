      {
        "id": 45,
        "sanskrit": "Jati-desha-kala-vyavahitanam apy anantaryam smriti-samskarayoh eka-rupata",
        "english": "Memory and impressions are one in form, even when separated by birth, place, and time.",
        "theme": "Karma",
        "source": "Yoga Sutras 4.9"
      },
      {
        "id": 46,
        "sanskrit": "Tasam anaditvam cha ashisho nityatvat",
        "english": "These are beginningless because the desire for liberation is eternal.",
        "theme": "Karma",
        "source": "Yoga Sutras 4.10"
      },
      {
        "id": 47,
        "sanskrit": "Hetu-phala-ashraya-alambanaih sangrihitatvat esham abhave tad-abhavah",
        "english": "When cause, effect, support, and object are absent, karma ceases.",
        "theme": "Liberation",
        "source": "Yoga Sutras 4.11"
      },
      {
        "id": 48,
        "sanskrit": "Atita-anagatam svarupatah asti adhva-bhedat dharmanam",
        "english": "Past and future exist in their own nature; the difference is in the dharma.",
        "theme": "Time",
        "source": "Yoga Sutras 4.12"
      },
      {
        "id": 49,
        "sanskrit": "Te pratiprasava-heyah sukshmah",
        "english": "The subtle impressions are destroyed by the return to the source.",
        "theme": "Liberation",
        "source": "Yoga Sutras 4.13"

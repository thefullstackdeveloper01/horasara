        "source": "Yoga Sutras 4.16"
      },
      {
        "id": 54,
        "sanskrit": "Tad-uparaga-apekshatvat chittasya vastu jnata-ajnatam",
        "english": "An object is known or unknown depending on whether the mind is colored by it.",

      {
        "id": 44,
        "sanskrit": "Karma-ashaya-klesha-vipaka-ashayah",
        "english": "The storehouse of karma, afflictions, and their fruits.",
        "theme": "Karma",
        "source": "Yoga Sutras 4.8"

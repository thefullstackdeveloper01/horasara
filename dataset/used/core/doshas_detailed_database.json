            "metal": "Gold or Copper",
            "finger": "Ring finger",
            "day_to_wear": "Tuesday",
            "note": "Only wear after proper astrological consultation"
          }
        ],
        
        "donation_remedies": [
          {
            "item": "Masoor Dal (Red Lentils)",
            "day": "Tuesday",
            "benefit": "Pacifies Mars"
          },
          {
            "item": "Red cloth",
            "day": "Tuesday",
            "benefit": "Reduces Manglik effects"
          },
          {
            "item": "Jaggery (Gud)",
            "day": "Tuesday",
            "benefit": "Improves marital prospects"

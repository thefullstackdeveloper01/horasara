    "pitru_dosha": {
      "dosha_name": "Pitru Dosha (पितृ दोष)",
      "also_known_as": ["Pitru Shraap", "Ancestral Curse", "Pitru Rin"],
      "planets_involved": ["Sun", "Rahu", "Saturn", "Jupiter"],
      "description": "Pitru Dosha occurs when ancestors are displeased due to unperformed rites, curses, or unfulfilled desires. This dosha indicates karmic debt to ancestors.",
      
      "rules": {
        "formation_conditions": [
          {
            "condition": "Sun with Rahu or Ketu",
            "effect": "Strong Pitru Dosha formation"
          },
          {
            "condition": "Sun and Saturn conjunction",
            "effect": "Ancestral curse indicator"
          },
          {
            "condition": "Rahu in 9th house",
            "effect": "Pitru Dosha (father-related karma)"
          },
          {
            "condition": "Sun debilitated in 9th house",
            "effect": "Displeased ancestors"
          },
          {
            "condition": "Jupiter in 9th house with Rahu",
            "effect": "Pitru Dosha with guru-related karma"

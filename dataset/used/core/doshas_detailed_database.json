    "manglik_dosha": {
      "dosha_name": "Manglik Dosha (मांगलिक दोष)",
      "also_known_as": ["Kuja Dosha", "Mangal Dosha", "Chevvai Dosham"],
      "planet_involved": "Mars (Mangal)",
      "description": "Manglik Dosha occurs when Mars is placed in certain houses of the birth chart, affecting marital harmony and potentially causing delays or obstacles in marriage.",
      
      "rules": {
        "houses_causing_dosha": {
          "primary_houses": [1, 2, 4, 7, 8, 12],
          "from_lagna": true,
          "from_moon": true,
          "from_venus": true,
          "note": "Dosha considered from Lagna, Moon, and Venus in descending order of importance"
        },
        
        "exceptions": {
          "cancellation_conditions": [
            {
              "condition": "Mars in own house (Mesha or Vrischika)",
              "effect": "Dosha cancelled"
            },
            {
              "condition": "Mars in exaltation (Makara)",
              "effect": "Dosha reduced by 50%"
            },
            {
              "condition": "Mars aspected by Jupiter",
              "effect": "Dosha significantly reduced"
            },
            {
              "condition": "Mars in 2nd house for Mesha Lagna",
              "effect": "Dosha not applicable"
            },
            {
              "condition": "Mars in 4th house for Karka Lagna",
              "effect": "Dosha not applicable"
            },
            {
              "condition": "Mars in 7th house for Makara Lagna",
              "effect": "Dosha not applicable"
            },
            {
              "condition": "Mars in 8th house for Dhanu or Meena Lagna",
              "effect": "Dosha cancelled"
            },
            {
              "condition": "Mars in 12th house for Vrishabha or Tula Lagna",
              "effect": "Dosha cancelled"
            }
          ]
        },
        
        "severity_levels": {
          "high_severity": {
            "houses": [7, 8],
            "description": "Mars in 7th or 8th house from Lagna",
            "impact": "Significant marital discord, possibility of separation or spouse health issues"
          },
          "moderate_severity": {
            "houses": [1, 2, 4, 12],
            "description": "Mars in 1st, 2nd, 4th, or 12th house",
            "impact": "Moderate delays and adjustments needed in married life"
          }
        },
        
        "matching_considerations": {
          "manglik_matching_rules": [
            "Manglik should ideally marry Manglik",
            "If one partner is Manglik and other is not, check cancellation",
            "Same severity level match is ideal",
            "Check Mars position in Navamsa chart"
          ]
        }
      },
      
      "remedies": {

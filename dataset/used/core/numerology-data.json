    "meanings": {
        "1": {
            "name": "The Leader",
            "planet": "Sun",
            "traits": "Independent, pioneering, ambitious, self-reliant. Born to lead. Strong ego and determination.",
            "career": "Entrepreneur, executive, politician, military leader",
            "challenge": "Avoid ego and stubbornness"
        },
        "2": {
            "name": "The Diplomat",
            "planet": "Moon",
            "traits": "Cooperative, sensitive, intuitive, diplomatic. Excel at partnerships. Excellent mediator.",
            "career": "Counsellor, teacher, musician, diplomat, healer",
            "challenge": "Avoid over-sensitivity and indecision"
        },
        "3": {
            "name": "The Communicator",
            "planet": "Jupiter",
            "traits": "Creative, expressive, joyful, social, artistic. Life of the party. Excellent communicator.",
            "career": "Artist, writer, actor, teacher, comedian",
            "challenge": "Avoid scattered energy and superficiality"
        },
        "4": {
            "name": "The Builder",
            "planet": "Rahu",
            "traits": "Practical, disciplined, methodical, stable. The most reliable of all numbers.",
            "career": "Engineer, architect, accountant, manager",
            "challenge": "Avoid rigidity and workaholism"
        },
        "5": {
            "name": "The Adventurer",
            "planet": "Mercury",
            "traits": "Freedom-loving, versatile, quick-thinking, adaptable. Craves variety and change.",
            "career": "Journalist, sales, travel, marketing, entrepreneur",
            "challenge": "Avoid restlessness and excess"
        },
        "6": {
            "name": "The Nurturer",
            "planet": "Venus",
            "traits": "Loving, responsible, family-oriented, harmonious. Natural caretaker. Community pillar.",
            "career": "Doctor, nurse, teacher, artist, home decorator",
            "challenge": "Avoid perfectionism and martyrdom"
        },
        "7": {
            "name": "The Seeker",
            "planet": "Ketu",
            "traits": "Analytical, spiritual, wise, introspective, mysterious. Deep thinker and researcher.",
            "career": "Scientist, researcher, philosopher, analyst, mystic",
            "challenge": "Avoid isolation and skepticism"
        },
        "8": {
            "name": "The Achiever",
            "planet": "Saturn",
            "traits": "Ambitious, powerful, practical, executive. Best at managing money and large organizations.",
            "career": "Business executive, banker, judge, politician",
            "challenge": "Avoid materialism and ruthlessness"
        },
        "9": {
            "name": "The Humanitarian",
            "planet": "Mars",
            "traits": "Compassionate, generous, idealistic, courageous. Global citizen. Natural healer and teacher.",
            "career": "Doctor, humanitarian, artist, teacher, spiritual leader",
            "challenge": "Avoid martyrdom and emotional drama"
        },
        "11": {
            "name": "The Visionary",
            "planet": "Moon",
            "traits": "Master number. Intuitive genius, spiritual messenger, inspirational leader.",
            "career": "Spiritual teacher, inventor, healer, artist",
            "challenge": "Must live up to high vibration, avoid nervous anxiety"
        },
        "22": {
            "name": "The Master Builder",
            "planet": "Rahu",
            "traits": "Master number. Combines 4 practicality with 11 vision. Greatest potential of all numbers.",
            "career": "Large organization builder, political leader, architect",
            "challenge": "Immense pressure to deliver on massive visions"
        },
        "33": {
            "name": "The Master Teacher",
            "planet": "Jupiter",
            "traits": "Master number. Amplifies 6 themes of care, teaching, compassion, and service; 33 reduces to 6.",
            "career": "Spiritual teacher, healer, humanitarian",
            "challenge": "Must sacrifice personal desires for higher good"
        }
    },

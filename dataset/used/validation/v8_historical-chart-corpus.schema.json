{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"HoraSaar V8 Historical Chart Corpus",
  "type":"object",
  "required":["id","birth","location","source","verification","expected"],
  "properties":{
    "id":{"type":"string","minLength":3},
    "birth":{"type":"object","required":["date","time","timezone"],"properties":{"date":{"type":"string"},"time":{"type":"string"},"timezone":{"type":"number"}}},
    "location":{"type":"object","required":["latitude","longitude"],"properties":{"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180}}},
    "source":{"type":"object","required":["kind","citation"],"properties":{"kind":{"type":"string"},"citation":{"type":"string"},"retrievedAt":{"type":"string"}}},
    "verification":{"type":"object","required":["status"],"properties":{"status":{"enum":["verified","unverified"]},"method":{"type":"string"}}},
    "expected":{"type":"object","required":["provider","values"],"properties":{"provider":{"type":"string"},"values":{"type":"object"}}}
  },
  "additionalProperties":true
}

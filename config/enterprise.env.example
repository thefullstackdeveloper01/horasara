# Optional SMTP email delivery
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Or use a generic JSON SMS webhook:
SMS_WEBHOOK_URL=

HORASAAR_SUBSCRIPTIONS_FILE=data/runtime/subscriptions.json
HORASAAR_OUTBOX_DIR=data/runtime/outbox
SCHEDULER_POLL_MS=60000

# Public astronomy/space-weather feeds (server-side only; never expose this key to browser JS)
NASA_API_KEY=
NASA_DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI-API/get
